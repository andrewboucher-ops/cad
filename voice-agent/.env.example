# Echelon phone assistant — copy to /etc/cccs/voice-agent.env and fill in

# Claude (the conversation). Haiku is quickest for live calls.
ANTHROPIC_API_KEY=
VOICE_MODEL=claude-haiku-5-5

# Deepgram (speech-to-text and the voice). EU endpoint keeps call audio in the EU.
DEEPGRAM_API_KEY=
DEEPGRAM_HOST=api.eu.deepgram.com
STT_MODEL=nova-3
# British voices: aura-2-pandora-en (female), aura-2-draco-en (male)
TTS_VOICE=aura-2-pandora-en

# CCCS — same VOICE_SECRET as in CCCS's .env
CCCS_URL=http://127.0.0.1:4000
VOICE_SECRET=

# Ports FreePBX connects to (keep them on the LAN; never forward them)
AGENT_HOST=0.0.0.0
AGENT_HTTP_PORT=8091
AGENT_AUDIO_PORT=9092

# Optional: replace the greeting
# VOICE_GREETING=Hello, you're through to Echelon...
