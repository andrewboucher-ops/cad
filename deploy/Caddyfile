# TLS is not optional here: geolocation is blocked on plain HTTP, so without
# this officer and vehicle position reporting silently stops working. Caddy
# gets and renews the certificate automatically.

__DOMAIN__ {
	encode zstd gzip

	# WebSocket upgrade passes through untouched
	reverse_proxy 127.0.0.1:4000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}

	log {
		output file /var/log/caddy/cccs.log {
			roll_size 50MiB
			roll_keep 14
		}
	}
}
