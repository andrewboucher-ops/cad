# Required. HMAC key for signed session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server generates an ephemeral one and warns — sessions drop on restart.
AUTH_SECRET=

PORT=4000
HOST=0.0.0.0

# Session lifetimes (ms)
TOKEN_TTL_MS=28800000
MDT_TOKEN_TTL_MS=86400000
IDEMPOTENCY_TTL_MS=

# on = simulated GPS movement continues; off once real devices report positions
SIMULATION=on

# Persistence (node:sqlite)
DATA_FILE=./data/cccs.db
PERSISTENCE=on
FLUSH_MS=1000

# Your fleet definition, read on first boot only — see seed.example.json
SEED_FILE=./seed.json

# Retention sweeps
RETENTION=on
RETAIN_LOCATIONS_DAYS=31
RETAIN_AUDIT_DAYS=365
RETAIN_COMMS_DAYS=180
RETAIN_MESSAGES_DAYS=
RETAIN_STATUS_DAYS=
RETAIN_JOBS_DAYS=730

# WebRTC ICE servers (JSON array). Defaults to Google STUN if unset — add a TURN
# server before trusting audio on mobile networks.
ICE_SERVERS=
AUDIO=

# Lone-worker welfare timers
WELFARE_TICK_MS=5000
WELFARE_WARN_S=60

# Telephony (FreePBX / Asterisk ARI) — leave PBX_MODE=simulated with no PBX
PBX_MODE=simulated
PSTN_PREFIX=9
ARI_URL=
ARI_USER=
ARI_PASSWORD=
ARI_APP=
PBX_OUTBOUND_CONTEXT=from-internal
PBX_SECRET=

# Microsoft Entra ID SSO (optional — local username/password always still works)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=

# Web Push (emergency/call/job alerts to a phone with the console added to its
# home screen). The VAPID keypair itself is generated on first boot and stored
# in the database — nothing to set for that. This is just the contact address
# push services show if they need to reach you about your server.
VAPID_SUBJECT=mailto:admin@echeloncic.com
