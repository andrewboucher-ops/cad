# Required. HMAC key for signed session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server generates an ephemeral one and warns — sessions drop on restart.
AUTH_SECRET=

PORT=4000
HOST=0.0.0.0

# Session lifetimes (ms)
TOKEN_TTL_MS=28800000
MDT_TOKEN_TTL_MS=86400000
IDEMPOTENCY_TTL_MS=

# on = simulated GPS movement continues; off once real devices report positions
SIMULATION=on

# Persistence (node:sqlite)
DATA_FILE=./data/cccs.db
PERSISTENCE=on
FLUSH_MS=1000

# Your fleet definition, read on first boot only — see seed.example.json
SEED_FILE=./seed.json

# Retention sweeps
RETENTION=on
RETAIN_LOCATIONS_DAYS=31
RETAIN_AUDIT_DAYS=365
RETAIN_MESSAGES_DAYS=180
RETAIN_JOBS_DAYS=730

# Lone-worker welfare timers
WELFARE_TICK_MS=5000
WELFARE_WARN_S=60

# GuardM8 integration (shared-secret auth for POST /api/integrations/guardm8/jobs)
GUARDM8_SECRET=

# Microsoft Entra ID SSO (optional — local username/password always still works)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=

# Email via Microsoft Graph, app-only (resolution reports, shift
# notifications). Reuses the four vars above — SSO can work with none of
# this set, but email needs MS_GRAPH_SENDER too (GRAPH_MAIL_ENABLED checks
# all four). The app registration needs the Mail.Send APPLICATION
# permission, admin-consented; scoping it to this one mailbox via an
# Exchange ApplicationAccessPolicy is recommended, since app-only Mail.Send
# otherwise grants send-as-any-mailbox in the tenant.
# Every system email is sent from this mailbox, e.g. donotreply@echeloncic.com
# (a shared mailbox is enough — it needs no licence).
MS_GRAPH_SENDER=
# Optional: where replies go (a watched inbox), since nobody reads
# donotreply. Several emails say "reply to this email".
MAIL_REPLY_TO=
# Optional extra recipient CC'd on every resolution report.
RESOLUTION_REPORT_CC=

# Outlook rota calendar (rota-calendar.js) — every published shift as an
# event in one mailbox's own "Echelon Rota" calendar. Off until
# MS_TENANT_ID and a client id + secret are set. Uses its own app
# registration if ROTA_MS_CLIENT_ID/ROTA_MS_CLIENT_SECRET are set
# (recommended: give that app only Calendars.ReadWrite, APPLICATION,
# admin-consented, and limit it to the rota mailbox with an Exchange
# ApplicationAccessPolicy), otherwise the MS_CLIENT_ID app above. Never
# emails anyone: events have no attendees. Backfill by hand with
# deploy/rota-calendar-sync.sh; the server also reconciles after every
# start and nightly.
ROTA_MS_CLIENT_ID=
ROTA_MS_CLIENT_SECRET=
# Mailbox that owns the calendar, and the calendar's name (found or created).
ROTA_CALENDAR_OWNER=andrew.boucher@echeloncic.com
ROTA_CALENDAR_NAME=Echelon Rota
# London hour (0-23) of the nightly reconcile.
ROTA_CALENDAR_RECONCILE_HOUR=2

# The public URL this server is reached at — used to build links in shift
# notifications (SMS/email) and personal iCal feed URLs. No trailing slash.
PUBLIC_BASE_URL=https://comms.echeloncic.com

# Web Push (emergency/call/job alerts to a phone with the console added to its
# home screen). The VAPID keypair itself is generated on first boot and stored
# in the database — nothing to set for that. This is just the contact address
# push services show if they need to reach you about your server.
VAPID_SUBJECT=mailto:admin@echeloncic.com
