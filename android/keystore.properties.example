# Copy to keystore.properties and fill in. That file is gitignored — never commit it.
# Generate the keystore with:
#   keytool -genkey -v -keystore cccs-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias cccs
#
# Back this file and the .jks up somewhere safe and offline. Lose them and you
# cannot ship an update to an installed app — every handset has to be wiped and
# reinstalled from scratch.
storeFile=cccs-release.jks
storePassword=
keyAlias=cccs
keyPassword=
