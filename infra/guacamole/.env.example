# install.sh writes /opt/guacamole/.env from this. Keep it out of git.

# Public hostname. Its DNS must point at this server (or the router forwarding
# 80/443 to it) before first start, so Caddy can get a certificate.
GUAC_DOMAIN=remote.example.com

# Generated by install.sh: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# TOTP for local logins. Leave on until Entra SSO works; see README.md.
TOTP_ENABLED=true
