# Microsoft Entra ID single sign-on for Guacamole.
# Copy to /opt/guacamole/openid.env, fill in the tenant and client IDs,
# then: docker compose up -d
# The README's "Entra ID sign-in" section covers the app registration.

OPENID_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<TENANT_ID>/oauth2/v2.0/authorize
OPENID_JWKS_ENDPOINT=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys
OPENID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
OPENID_CLIENT_ID=<APPLICATION_CLIENT_ID>
# Must match the redirect URI on the app registration exactly, trailing slash included.
OPENID_REDIRECT_URI=https://remote.example.com/

# Usernames come from the UPN (andrew@company.com).
OPENID_USERNAME_CLAIM_TYPE=preferred_username
# Entra security groups arrive as object IDs. A Guacamole user group whose
# name is that object ID gives its members the group's connections.
OPENID_GROUPS_CLAIM_TYPE=groups

# Keep the local login form (for the break-glass admin), with a
# "Sign in with OpenID" link under it.
EXTENSION_PRIORITY=*, openid
