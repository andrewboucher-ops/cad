(guacamole) {
	encode zstd gzip

	# WebSockets are proxied without extra config. Long idle timeouts keep
	# quiet RDP sessions from being cut off.
	reverse_proxy guacamole:8080 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

# Public name, with a real certificate from Let's Encrypt.
{$GUAC_DOMAIN} {
	import guacamole
}

# The server's LAN IP, with Caddy's own certificate (browser warning expected).
# For setup and as a fallback when the public name isn't reachable.
# Microsoft sign-in only works on the public name.
https://{$GUAC_LAN_IP:127.0.0.1} {
	tls internal
	import guacamole
}
