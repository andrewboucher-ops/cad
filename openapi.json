{
  "openapi": "3.0.3",
  "info": {
    "title": "CCCS — Critical Communications, Dispatch & Control-Room System",
    "version": "0.2.0",
    "description": "Commercial security operations platform: dispatch, patrol/paperwork tracking, HR rota and asset tracking. Radio communications are handled by BroadNet, outside this system."
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Sign in and receive a bearer token",
        "security": [],
        "responses": {
          "200": {
            "description": "token + user"
          },
          "401": {
            "description": "invalid credentials"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Current user",
        "responses": {
          "200": {
            "description": "user"
          }
        }
      }
    },
    "/api/mdts": {
      "get": {
        "summary": "List mobile data terminals",
        "responses": {
          "200": {
            "description": "mdts"
          }
        }
      },
      "post": {
        "summary": "Create an MDT (SYSTEM_ADMIN)",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/api/mdts/{id}": {
      "patch": {
        "summary": "Update an MDT (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "mdt"
          }
        }
      },
      "delete": {
        "summary": "Delete an MDT (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/mdts/{id}/crew": {
      "post": {
        "summary": "Sign a crew member into a vehicle terminal (up to 3)",
        "responses": {
          "200": {
            "description": "mdt"
          }
        }
      }
    },
    "/api/mdts/{id}/crew/{crewId}": {
      "delete": {
        "summary": "Sign a crew member out",
        "responses": {
          "200": {
            "description": "mdt"
          }
        }
      }
    },
    "/api/mdts/{id}/duty-status": {
      "post": {
        "summary": "Set an MDT's duty status (available/busy/meal break/out of service)",
        "responses": {
          "200": {
            "description": "mdt"
          }
        }
      }
    },
    "/api/mdts/{id}/location": {
      "post": {
        "summary": "Push a GPS fix for a vehicle terminal",
        "responses": {
          "200": {
            "description": "mdt"
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "summary": "List fleet vehicles",
        "responses": {
          "200": {
            "description": "vehicles"
          }
        }
      }
    },
    "/api/personnel": {
      "get": {
        "summary": "List personnel",
        "responses": {
          "200": {
            "description": "personnel"
          }
        }
      }
    },
    "/api/personnel/{id}/welfare": {
      "post": {
        "summary": "Start or reset a lone-worker welfare timer",
        "responses": {
          "200": {
            "description": "personnel"
          },
          "400": {
            "description": "interval out of range"
          }
        }
      },
      "delete": {
        "summary": "Cancel a welfare timer",
        "responses": {
          "200": {
            "description": "personnel"
          },
          "409": {
            "description": "no timer running"
          }
        }
      }
    },
    "/api/personnel/{id}/welfare/check": {
      "post": {
        "summary": "Check in against a running welfare timer",
        "responses": {
          "200": {
            "description": "personnel"
          }
        }
      }
    },
    "/api/personnel/{id}/erase-location-history": {
      "post": {
        "summary": "Erase a person's stored GPS location history (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/callsigns": {
      "get": {
        "summary": "List call signs with their MDTs and personnel",
        "responses": {
          "200": {
            "description": "call signs"
          }
        }
      },
      "post": {
        "summary": "Create a call sign",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/api/callsigns/{id}/assign": {
      "post": {
        "summary": "Assign an MDT to a call sign",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "delete": {
        "summary": "Remove an MDT from a call sign",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List jobs",
        "responses": {
          "200": {
            "description": "jobs"
          }
        }
      },
      "post": {
        "summary": "Create a job",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "patch": {
        "summary": "Update job status, notes or incident details",
        "responses": {
          "200": {
            "description": "job"
          }
        }
      }
    },
    "/api/jobs/{id}/assign": {
      "post": {
        "summary": "Dispatch a job to call signs, personnel or MDTs",
        "responses": {
          "200": {
            "description": "job"
          }
        }
      }
    },
    "/api/jobs/{id}/ack": {
      "post": {
        "summary": "Acknowledge a dispatched job",
        "responses": {
          "200": {
            "description": "job"
          }
        }
      }
    },
    "/api/jobs/{id}/stand-down": {
      "post": {
        "summary": "Remove a person or MDT from a job",
        "responses": {
          "200": {
            "description": "job"
          }
        }
      }
    },
    "/api/jobs/{id}/checklist/{itemId}": {
      "patch": {
        "summary": "Update a job's on-scene checklist item",
        "responses": {
          "200": {
            "description": "job"
          }
        }
      }
    },
    "/api/jobs/{id}/media": {
      "post": {
        "summary": "Attach a photo to a job (base64, jpeg/png/webp, 8MB max)",
        "responses": {
          "201": {
            "description": "media"
          },
          "413": {
            "description": "photo too large"
          }
        }
      }
    },
    "/api/jobs/{id}/media/{mediaId}": {
      "get": {
        "summary": "Fetch a job photo",
        "responses": {
          "200": {
            "description": "image bytes"
          }
        }
      }
    },
    "/api/integrations/guardm8/jobs": {
      "post": {
        "summary": "GuardM8 alarm-receiving integration: create a job (shared-secret auth via X-GuardM8-Secret, not a user session)",
        "security": [],
        "responses": {
          "201": {
            "description": "created"
          },
          "200": {
            "description": "already created for this external_ref"
          },
          "401": {
            "description": "bad secret"
          }
        }
      }
    },
    "/api/emergency": {
      "get": {
        "summary": "List emergency events",
        "responses": {
          "200": {
            "description": "events"
          }
        }
      },
      "post": {
        "summary": "Activate an officer or vehicle emergency",
        "responses": {
          "201": {
            "description": "event"
          }
        }
      }
    },
    "/api/emergency/{id}/ack": {
      "post": {
        "summary": "Acknowledge an emergency",
        "responses": {
          "200": {
            "description": "event"
          }
        }
      }
    },
    "/api/emergency/{id}/resolve": {
      "post": {
        "summary": "Reset an emergency",
        "responses": {
          "200": {
            "description": "event"
          }
        }
      }
    },
    "/api/messages": {
      "get": {
        "summary": "List messages visible to the caller",
        "responses": {
          "200": {
            "description": "messages"
          }
        }
      },
      "post": {
        "summary": "Send a text message to a person, an MDT, or control",
        "responses": {
          "201": {
            "description": "message"
          }
        }
      }
    },
    "/api/messages/{id}/read": {
      "post": {
        "summary": "Mark a message read",
        "responses": {
          "200": {
            "description": "message"
          }
        }
      }
    },
    "/api/calls/request": {
      "post": {
        "summary": "Request a callback from control",
        "responses": {
          "200": {
            "description": "existing pending request, possibly escalated"
          },
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/api/calls/requests": {
      "get": {
        "summary": "List callback requests",
        "responses": {
          "200": {
            "description": "requests"
          }
        }
      }
    },
    "/api/calls/requests/{id}/clear": {
      "post": {
        "summary": "Clear a callback request (answered by control, or cancelled by the requester)",
        "responses": {
          "200": {
            "description": "request"
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Audit/event timeline with type, text and date filters",
        "responses": {
          "200": {
            "description": "events"
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "summary": "Full snapshot for console bootstrap",
        "responses": {
          "200": {
            "description": "state"
          }
        }
      }
    },
    "/api/retention": {
      "get": {
        "summary": "Current data-retention windows (CONTROL)",
        "responses": {
          "200": {
            "description": "retention"
          }
        }
      }
    },
    "/api/retention/sweep": {
      "post": {
        "summary": "Run the retention sweep now (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "counts removed"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "List users (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "users"
          }
        }
      },
      "post": {
        "summary": "Create a user (SYSTEM_ADMIN)",
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/api/users/{id}": {
      "patch": {
        "summary": "Update a user (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "user"
          }
        }
      },
      "delete": {
        "summary": "Delete a user (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/sites": {
      "get": {
        "summary": "List sites under contract",
        "responses": {
          "200": {
            "description": "sites"
          }
        }
      },
      "post": {
        "summary": "Add a site",
        "responses": {
          "201": {
            "description": "created"
          },
          "409": {
            "description": "site exists"
          }
        }
      }
    },
    "/api/sites/{id}": {
      "patch": {
        "summary": "Update a site, including its on-scene checklist template (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "site"
          }
        }
      },
      "delete": {
        "summary": "Delete a site (SYSTEM_ADMIN)",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Client bootstrap config",
        "responses": {
          "200": {
            "description": "config"
          }
        }
      }
    }
  }
}
