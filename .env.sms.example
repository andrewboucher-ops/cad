# SMS via Twilio (optional — the click-to-SMS button is inert without it)
#
# SMS_LIVE is deliberately its own flag rather than inferred from credentials
# being present. Having an account is not consent to send: with this off,
# sms.js logs exactly what it would have sent and sends nothing, so the whole
# call path, audit write and UI can be exercised without a real text leaving
# the building. Turn it on only once you have tested against your own phone.
SMS_LIVE=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set ONE of these two. A Messaging Service is preferable where you have one:
# it carries the sender pool and opt-out handling, so replies route back
# correctly rather than to whichever number happened to send.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Must be the PUBLIC url Twilio calls, including any path. Twilio signs the
# exact URL it requested, so behind a proxy that rewrites host or path every
# callback fails signature validation — and stops arriving, silently.
SMS_STATUS_CALLBACK_URL=

# FreePBX / Asterisk (optional — for real click-to-dial with an outcome)
#
# A `tel:` link can only record that an operator pressed dial; the browser
# reports nothing about what happened next. Originating the call over the
# PBX instead means FreePBX can report answered / no-answer / busy and the
# call duration, which is what fills dial_log.outcome for DIAL rows.
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=
AMI_SECRET=
# The outbound context/trunk FreePBX should use for a console-originated call.
AMI_DIAL_CONTEXT=from-internal
# Whether a click-to-dial rings the OPERATOR first and then connects them to
# the officer (the usual ARC pattern — a browser has no audio path into a
# PBX, so someone has to answer a phone somewhere), or some other flow.
DIAL_RINGS_OPERATOR_FIRST=on
